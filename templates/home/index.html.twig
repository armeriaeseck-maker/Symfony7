{% extends 'base.html.twig' %}

{% block title %}
  Accueil
{% endblock %}

{% block body %}
  <div class="container mt-4">
    <h1>Accueil ✅</h1>

    {% if app.user %}
      <h2>Bonjour {{ app.user.prenom }}</h2>

      <p>Bienvenue sur votre espace personnel.</p>
    {% else %}
      <h2>Bienvenue</h2>

      <p>Veuillez vous connecter pour accéder à votre espace personnel.</p>
    {% endif %}
  </div>
{% endblock %}
