{{ form_start(form) }}

<div class="row">
  <div class="col">{{ form_row(form.email) }}</div>
</div>

<div class="row">
  <div class="col">{{ form_row(form.roles, { value: form.vars.data.roles }) }}</div>
</div>

<div class="row">
  <div class="col">{{ form_row(form.nom) }}</div>
</div>

<div class="row">
  <div class="col">{{ form_row(form.prenom) }}</div>
</div>

<div class="mt-3 d-flex gap-2">
  <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm">💾 {{ button_label|default('Enregistrer') }}</button>

  <a href="{{ path('app_user_index') }}" class="btn btn-secondary rounded-pill px-4">↩ Retour</a>
</div>

{{ form_end(form) }}
