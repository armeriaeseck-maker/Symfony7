{% extends 'base.html.twig' %}

{% block title %}
  Utilisateur
{% endblock %}

{% block body %}
  <div class="card shadow mt-4">
    <div class="card-header bg-primary text-white">
      <h3 class="mb-0">👤 Détails de l'utilisateur</h3>
    </div>

    <div class="card-body">
      <table class="table table-striped">
        <tbody>
          <tr>
            <th>ID</th>
            <td>{{ user.id }}</td>
          </tr>

          <tr>
            <th>Email</th>
            <td>{{ user.email }}</td>
          </tr>

          <tr>
            <th>Rôle</th>
            <td>{{ user.roles|join(', ') }}</td>
          </tr>

          <tr>
            <th>Nom</th>
            <td>{{ user.nom }}</td>
          </tr>

          <tr>
            <th>Prénom</th>
            <td>{{ user.prenom }}</td>
          </tr>
        </tbody>
      </table>

      <div class="d-flex gap-2 mt-4">
        <a href="{{ path('app_user_index') }}" class="btn btn-secondary">↩ Retour</a>

        <a href="{{ path('app_user_edit', { id: user.id }) }}" class="btn btn-warning text-white">✏️ Modifier</a>

        {{ include('user/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
{% endblock %}
