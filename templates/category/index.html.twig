{% extends 'base.html.twig' %}
{% block title %}
  Category index
{% endblock %}
{% block body %}
  <h1>Category index</h1>
  <table class="table">
    <thead>
      <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Description</th>
        <th>Image</th>
        <th>Date_add</th>
        <th>actions</th>
      </tr>
    </thead>
    <tbody>
      {% for category in categories %}
        <tr>
          <td>{{ category.id }}</td>
          <td>{{ category.name }}</td>
          <td>{{ category.Description }}</td>
          <td>{{ category.Image }}</td>
          <td class="text-nowrap">{{ category.DateAdd ? category.DateAdd|date('Y-m-d H:i:s') : '' }}</td>
          <td class="text-nowrap">
            <div class="d-flex gap-2">
              <a href="{{ path('app_category_show', { id: category.id }) }}" class="btn btn-info btn-sm text-white rounded-pill">👁 Voir</a>

              <a href="{{ path('app_category_edit', { id: category.id }) }}" class="btn btn-warning btn-sm text-white rounded-pill">✏️ Modifier</a>
            </div>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6">no records found</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
  <a href="{{ path('app_category_new') }}" class="btn btn-success rounded-pill px-4 shadow-sm">➕ Nouvelle catégorie</a>
{% endblock %}
