{% extends 'base.html.twig' %}

{% block title %}
  Modifier une catégorie
{% endblock %}

{% block body %}
  <div class="card shadow-sm">
    <div class="card-header bg-warning text-dark">
      <h2 class="mb-0">✏️ Modifier la catégorie</h2>
    </div>

    <div class="card-body">
      {{ include('category/_form.html.twig', { button_label: '💾 Mettre à jour' }) }}

      <div class="d-flex gap-2 mt-4">
        <a href="{{ path('app_category_index') }}" class="btn btn-secondary rounded-pill px-4">📋 Retour à la liste</a>

        {{ include('category/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
{% endblock %}
