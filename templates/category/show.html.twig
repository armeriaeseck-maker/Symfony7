{% extends 'base.html.twig' %}

{% block title %}
  Category
{% endblock %}

{% block body %}
  <div class="container mt-4">
    <h1>Category</h1>

    <table class="table table-striped table-bordered">
      <tbody>
        <tr>
          <th>Id</th>
          <td>{{ category.id }}</td>
        </tr>
        <tr>
          <th>Name</th>
          <td>{{ category.name }}</td>
        </tr>
        <tr>
          <th>Description</th>
          <td>{{ category.description }}</td>
        </tr>
        <tr>
          <th>Image</th>
          <td>{{ category.image }}</td>
        </tr>
        <tr>
          <th>Date_add</th>
          <td>{{ category.dateAdd ? category.dateAdd|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
      </tbody>
    </table>

    <a class="btn btn-secondary" href="{{ path('app_category_index') }}">Retour à la liste</a>

    <a class="btn btn-warning" href="{{ path('app_category_edit', { id: category.id }) }}">Modifier</a>

    {{ include('category/_delete_form.html.twig') }}
  </div>
{% endblock %}
