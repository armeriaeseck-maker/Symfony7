<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container">
    <a class="navbar-brand" href="{{ path('app_home') }}">Navbar</a>
    {% if is_granted('ROLE_EMPLOYEE') %}
      <a class="nav-link ms-3 me-3" href="{{ path('app_product') }}">Produit</a>

      <a class="nav-link" href="{{ path('app_category_index') }}">Catégorie</a>
    {% endif %}
    {% if is_granted('ROLE_ADMIN') %}
      <a class="nav-link ms-3 me-3" href="/user">Utilisateur</a>
    {% endif %}

    <div class="ms-auto text-end">
      {% if app.user %}
        <span class="me-3">{{ app.user.email }}</span>

        <a href="{{ path('app_logout') }}">Logout</a>

        <br />

        <small>{{ app.user.prenom }}</small>
      {% else %}
        <a href="{{ path('app_login') }}">Se connecter</a>
      {% endif %}
    </div>
  </div>
</nav>
