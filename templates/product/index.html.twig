{% extends 'base.html.twig' %}

{% block title %}
  Produits
{% endblock %}

{% block body %}
  <h1>Produits ✅</h1>

  {% if app.user %}
    <h2>Bonjour {{ app.user.prenom }}</h2>

    {# <p>Rôles enregistrés : {{ app.user.roles|join(', ') }}</p> #}

    {% if is_granted('ROLE_ADMIN') %}
      <h3>👑 Vous êtes ADMIN</h3>
    {% endif %}

    {% if is_granted('ROLE_EMPLOYEE') %}
      <h3>🛠 Vous êtes EMPLOYÉ</h3>
    {% endif %}

    {% if is_granted('ROLE_USER') %}
      <h3>👤 Vous êtes UTILISATEUR</h3>
    {% endif %}
  {% endif %}
{% endblock %}
