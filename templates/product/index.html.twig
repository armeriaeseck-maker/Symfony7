{% extends 'base.html.twig' %}

{% block title %}
  Produits
{% endblock %}

{% block body %}
  <div class="container mt-4">
    <h1>Produits ✅</h1>

    {% if app.user %}
      <p>Rôles : {{ app.user.roles|join(', ') }}</p>

      {% if is_granted('ROLE_ADMIN') %}
        <h2>Vous êtes ADMIN {{ app.user.prenom }}</h2>
      {% endif %}

      {% if is_granted('ROLE_EMPLOYEE') %}
        <h2>Vous êtes employé {{ app.user.prenom }}</h2>
      {% endif %}

      {% if is_granted('ROLE_USER') %}
        <h2>Vous êtes utilisateur {{ app.user.prenom }}</h2>
      {% endif %}
    {% else %}
      <h2>Vous n'êtes pas connecté</h2>
    {% endif %}
  </div>
{% endblock %}
